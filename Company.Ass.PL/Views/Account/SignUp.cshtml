@model SignUpDto
@{
    ViewData["Title"] = "SignUp";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}



<div class="progress-bar">
    <div class="progress-fill" id="progressFill"></div>
</div>

<div asp-validation-summary="All" class="success-message" id="successMessage">
    ✓ Application submitted successfully! We'll review your pitch and get back to you soon.
</div>

<form id="fundingForm" asp-action="SignUp">
    <div class="form-section">
        <div class="section-title">
            <span class="section-number">1</span>
            Company Information
        </div>
        <div class="grid-2">
            <div class="form-group">
                <label>FirstName <span class="required">*</span></label>
                <input placeholder="Enter your First name" asp-for="FirstName" required>
            </div>
            <div class="form-group">
                <label>LastName</label>
                <input asp-for="LastName" placeholder="Enter your Last name">
            </div>
        </div>
        <div class="form-group">
            <label>Email<span class="required">*</span></label>
            <input asp-for="Email" placeholder="Enter your Email">
        </div>
        <div class="form-group">
            <label>Password <span class="required">*</span></label>
            <input asp-for="Password" required placeholder="Enter your Password">
        </div>
        <div class="form-group">
            <label>Confirm Password <span class="required">*</span></label>
            <input asp-for="ConfirmPassword" required placeholder="">
        </div>
        <input asp-for="IsAgree" class="form-check-box" required/>
        <span>I Agree To the Terms & Conditions</span>
    </div>
    <button type="submit" class="submit-btn">Submit Application</button>
    <p>Don't have an Account? <a asp-action="SignIn"> Login Now!</a></p>
</form>